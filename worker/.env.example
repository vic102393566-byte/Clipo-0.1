# Porta do servidor (o Google Cloud Run define automaticamente como 8080)
PORT=8080

# URL do projeto Supabase (a mesma utilizada no frontend do Clipo)
# Exemplo: https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Chave secreta Service Role do Supabase (MUITO IMPORTANTE: NUNCA expor no frontend)
# Obtida no painel Supabase -> Settings -> API -> service_role key
# Permite ao worker ler o vídeo original privado e gravar as partes cortadas no bucket clipo-videos
SUPABASE_SERVICE_ROLE_KEY=eyJh...sua_service_role_key_aqui

# Origens autorizadas para requisições CORS (domínios permitidos, separados por vírgula)
# NUNCA utilize '*' em produção. O worker rejeita origens não autorizadas.
# Padrões automáticos: https://clipo-0-1.vercel.app, http://localhost:3000
ALLOWED_ORIGIN=https://clipo-0-1.vercel.app,http://localhost:3000

# Diretório para armazenamento temporário dos arquivos de corte antes do upload para o Supabase
TEMP_DIR=/tmp/clipo-jobs
