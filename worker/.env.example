# Porta do servidor (o Google Cloud Run define automaticamente como 8080)
PORT=8080

# URL do projeto Supabase (a mesma utilizada no frontend do Clipo)
# Exemplo: https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Chave secreta Service Role do Supabase (MUITO IMPORTANTE: NUNCA expor no frontend)
# Obtida no painel Supabase -> Settings -> API -> service_role key
# Permite ao worker ler o vídeo original privado e gravar as partes cortadas e legendas no bucket clipo-videos
SUPABASE_SERVICE_ROLE_KEY=eyJh...sua_service_role_key_aqui

# Origens autorizadas para requisições CORS (domínios permitidos, separados por vírgula)
# NUNCA utilize '*' em produção. O worker rejeita origens não autorizadas.
# Padrões automáticos: https://clipo-0-1.vercel.app, http://localhost:3000
ALLOWED_ORIGIN=https://clipo-0-1.vercel.app,http://localhost:3000

# Diretório para armazenamento temporário dos arquivos de corte e legendas antes do upload
TEMP_DIR=/tmp/clipo-jobs

# ==============================================================================
# Configuração do Google Cloud Speech-to-Text (Legendas Automáticas com IA)
# ==============================================================================
# No Google Cloud Run, a autenticação pode ser NATIVA (sem chave de arquivo),
# bastando associar uma Service Account com o papel "Cloud Speech Client" (roles/speech.client).
#
# Para testes locais ou se preferir configurar via variável:
#
# Opção 1: Credenciais completas em formato JSON string (ideal para variáveis de ambiente)
# GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
#
# Opção 2: Caminho para o arquivo JSON de credenciais
# GOOGLE_APPLICATION_CREDENTIALS=/caminho/para/service-account.json
#
# Opção 3: Chave de API Google Speech
# GOOGLE_SPEECH_API_KEY=AIzaSy...
