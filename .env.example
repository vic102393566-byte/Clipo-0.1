# Supabase Storage & Database Configuration
# Obtenha em: Supabase Dashboard -> Project Settings -> API
# O bucket de armazenamento deve se chamar: clipo-videos (privado)
# IMPORTANTE: Nunca coloque a Service Role Key no frontend! Use apenas a chave pública (anon).
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TikTok Official API Credentials
# Configure these in TikTok for Developers portal (https://developers.tiktok.com)
TIKTOK_CLIENT_KEY="MY_TIKTOK_CLIENT_KEY"
TIKTOK_CLIENT_SECRET="MY_TIKTOK_CLIENT_SECRET"
TIKTOK_REDIRECT_URI="https://ais-dev-lfcxezhilf74k3anceyuue-460308902554.us-east1.run.app/api/auth/tiktok/callback"

# YouTube (Google) API Credentials
# Configure in Google Cloud Console (https://console.cloud.google.com/apis/credentials)
# Enable YouTube Data API v3 and create an OAuth 2.0 Web Client ID
YOUTUBE_CLIENT_ID="MY_YOUTUBE_CLIENT_ID"
YOUTUBE_CLIENT_SECRET="MY_YOUTUBE_CLIENT_SECRET"
YOUTUBE_REDIRECT_URI="https://ais-dev-lfcxezhilf74k3anceyuue-460308902554.us-east1.run.app/api/auth/youtube/callback"

# Instagram (Meta Graph API) Credentials
# Configure in Meta for Developers portal (https://developers.facebook.com)
# Create a Business app with Instagram Graph API product
INSTAGRAM_CLIENT_ID="MY_INSTAGRAM_CLIENT_ID"
INSTAGRAM_CLIENT_SECRET="MY_INSTAGRAM_CLIENT_SECRET"
INSTAGRAM_REDIRECT_URI="https://ais-dev-lfcxezhilf74k3anceyuue-460308902554.us-east1.run.app/api/auth/instagram/callback"
